# ===== qqpush 服务 =====
QQPUSH_HOST=0.0.0.0
QQPUSH_PORT=8088
# 外部调用 /push 的共享密钥，强烈建议设置
QQPUSH_TOKEN=change-me-please
# 独立的健康检查端口（可选，容器探针用）
QQPUSH_HEALTH_PORT=0
# 推送通道：official = 官方 QQ 机器人；onebot = NapCat/Lagrange
QQPUSH_CHANNEL=official
# 发送并发 / 队列长度 / 幂等去重窗口（秒）
QQPUSH_WORKERS=4
QQPUSH_QUEUE_SIZE=1000
QQPUSH_DEDUP_TTL=300
# markdown 是否降级为纯文本（官方通道只能发文本）
QQPUSH_MARKDOWN=true
QQPUSH_CODE_BLOCK=false
QQPUSH_DEFAULT_PREFIX=
QQPUSH_GROUPS_FILE=data/groups.json
QQPUSH_FAILED_LOG=data/failed.ndjson
QQPUSH_LOG_LEVEL=INFO

# ===== 官方 QQ 机器人（QQPUSH_CHANNEL=official）=====
# 开放平台 -> 你的机器人 -> 开发设置
QQBOT_APPID=
QQBOT_SECRET=
QQBOT_API_BASE=https://api.bot.qq.com
# 是否用 WebSocket 监听事件（用于自动获取 group_openid），默认 true
QQBOT_LISTEN=true
# 订阅的事件位，默认 1<<25 = GROUP_AND_C2C_EVENT（含群 @ 消息、机器人入群）
QQBOT_INTENTS=33554432
# 单条文本消息长度上限（超出截断）；官方对超长返回 40054007
QQBOT_MAX_CHARS=1000
# 官方可能拒绝含 URL 的消息（40054010），开启后自动替换为「（链接已省略）」
QQBOT_STRIP_URLS=false
# 每群每分钟最多发送条数（官方上限 20/分钟、1000/天）
QQBOT_GROUP_PER_MINUTE=18
# 官方接口超时（秒）与重试次数
ONEBOT_TIMEOUT=10
ONEBOT_RETRIES=2
# 全局每秒发送上限
QQPUSH_SEND_RATE_PER_SEC=5

# ===== OneBot 11（仅 QQPUSH_CHANNEL=onebot 时需要）=====
ONEBOT_BASE_URL=http://127.0.0.1:3000
ONEBOT_TOKEN=
# OneBot 单条群消息上限（超出自动分片）
QQPUSH_MAX_CHARS=4500
